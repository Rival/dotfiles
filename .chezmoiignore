# Exclude snapshots (btrfs/restic backup dirs)
.snapshots
**/.snapshots
**/*/.snapshots
**/snapshots/*

# Exclude cache directories
**/cache/
**/Cache/
**/__pycache__/
**/node_modules/
**/.local/state/

# Exclude large binary/config files that shouldn't be synced
**/Cache/
**/CachedData/
**/log/
**/logs/

# Machine-specific hardware configs (you can adjust this)
**/hardware-configuration.nix

# Exclude IDE specific caches
**/.idea/
**/.vscode/
**/Session.vim
**/sessions/

# Exclude history and temporary files
**/history.txt
**/.history
**/*.bak
**/*backup*

# Exclude compiled/binary files
**/*.pyc
**/*.msgpackz
**/plugin.msgpackz

# Contains real credentials (google/aws/atlassian) - never sync
.agents/config
**/.agents/config/

# Contains a live API key (models.json) - never sync as-is
.pi/agent/models.json
**/.pi/agent/models.json
